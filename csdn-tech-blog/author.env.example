# 博主全局配置（复制到本机，所有项目共用）
# macOS/Linux:
#   mkdir -p ~/.config/millennium-tech
#   cp author.env.example ~/.config/millennium-tech/blog-author.env
# Windows:
#   copy author.env.example %USERPROFILE%\.config\millennium-tech\blog-author.env

# —— 作者身份（公开信息，非密钥）——
BLOG_AUTHOR_NAME=CodeCaptain
BLOG_AUTHOR_REAL_NAME=刘晔瑛
BLOG_AUTHOR_TITLE=能源物联网产品公司技术副总/自由游戏全栈开发者
BLOG_AUTHOR_TRAITS=极客+极致用户体验师，技术布道师
BLOG_AUTHOR_CSDN_USERNAME=
BLOG_CONTACT_EMAIL=code_captain@163.com
BLOG_CONTACT_EMAIL_ALT=cavan.liu@mt-soft.com

# CSDN 博客主页（全局，所有项目共用）
BLOG_CSDN_HOME_URL=https://blog.csdn.net/mimica247706624

